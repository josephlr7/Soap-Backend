<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://novamarket.pe.cibertec/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             targetNamespace="http://novamarket.pe.cibertec/"
             name="FacturacionNovaMarketImplementService">
    <types>
        <xsd:schema targetNamespace="http://novamarket.pe.cibertec/" elementFormDefault="qualified">
            <xsd:complexType name="itemVentaRequest">
                <xsd:sequence>
                    <xsd:element name="productoId" type="xsd:long" minOccurs="0"/>
                    <xsd:element name="cantidad" type="xsd:int" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="ventaRequest">
                <xsd:sequence>
                    <xsd:element name="tipoComprobante" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="dniCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="rucEmpresa" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="metodoPago" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoCajero" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="items" type="tns:itemVentaRequest" minOccurs="0" maxOccurs="unbounded"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:complexType name="comprobanteResponse">
                <xsd:sequence>
                    <xsd:element name="codigoEstado" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="serie" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numero" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="estado" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="cliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="empresa" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="subtotal" type="xsd:decimal" minOccurs="0"/>
                    <xsd:element name="igv" type="xsd:decimal" minOccurs="0"/>
                    <xsd:element name="total" type="xsd:decimal" minOccurs="0"/>
                    <xsd:element name="metodoPago" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoOperacionInterna" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="hashFirma" type="xsd:string" minOccurs="0"/>
                </xsd:sequence>
            </xsd:complexType>
            <xsd:element name="registrarVenta"><xsd:complexType><xsd:sequence><xsd:element name="request" type="tns:ventaRequest" minOccurs="0"/></xsd:sequence></xsd:complexType></xsd:element>
            <xsd:element name="registrarVentaResponse"><xsd:complexType><xsd:sequence><xsd:element name="return" type="tns:comprobanteResponse" minOccurs="0"/></xsd:sequence></xsd:complexType></xsd:element>
            <xsd:element name="buscarComprobante"><xsd:complexType><xsd:sequence><xsd:element name="numero" type="xsd:string" minOccurs="0"/></xsd:sequence></xsd:complexType></xsd:element>
            <xsd:element name="buscarComprobanteResponse"><xsd:complexType><xsd:sequence><xsd:element name="return" type="tns:comprobanteResponse" minOccurs="0"/></xsd:sequence></xsd:complexType></xsd:element>
            <xsd:element name="listarComprobantes"><xsd:complexType><xsd:sequence/></xsd:complexType></xsd:element>
            <xsd:element name="listarComprobantesResponse"><xsd:complexType><xsd:sequence><xsd:element name="return" type="tns:comprobanteResponse" minOccurs="0" maxOccurs="unbounded"/></xsd:sequence></xsd:complexType></xsd:element>
            <xsd:element name="anularComprobante"><xsd:complexType><xsd:sequence><xsd:element name="numero" type="xsd:string" minOccurs="0"/></xsd:sequence></xsd:complexType></xsd:element>
            <xsd:element name="anularComprobanteResponse"><xsd:complexType><xsd:sequence><xsd:element name="return" type="xsd:string" minOccurs="0"/></xsd:sequence></xsd:complexType></xsd:element>
        </xsd:schema>
    </types>
    <message name="registrarVenta"><part name="parameters" element="tns:registrarVenta"/></message>
    <message name="registrarVentaResponse"><part name="parameters" element="tns:registrarVentaResponse"/></message>
    <message name="buscarComprobante"><part name="parameters" element="tns:buscarComprobante"/></message>
    <message name="buscarComprobanteResponse"><part name="parameters" element="tns:buscarComprobanteResponse"/></message>
    <message name="listarComprobantes"><part name="parameters" element="tns:listarComprobantes"/></message>
    <message name="listarComprobantesResponse"><part name="parameters" element="tns:listarComprobantesResponse"/></message>
    <message name="anularComprobante"><part name="parameters" element="tns:anularComprobante"/></message>
    <message name="anularComprobanteResponse"><part name="parameters" element="tns:anularComprobanteResponse"/></message>
    <portType name="IFacturacionNovaMarketService">
        <operation name="registrarVenta"><input message="tns:registrarVenta"/><output message="tns:registrarVentaResponse"/></operation>
        <operation name="buscarComprobante"><input message="tns:buscarComprobante"/><output message="tns:buscarComprobanteResponse"/></operation>
        <operation name="listarComprobantes"><input message="tns:listarComprobantes"/><output message="tns:listarComprobantesResponse"/></operation>
        <operation name="anularComprobante"><input message="tns:anularComprobante"/><output message="tns:anularComprobanteResponse"/></operation>
    </portType>
    <binding name="FacturacionNovaMarketImplementPortBinding" type="tns:IFacturacionNovaMarketService">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document"/>
        <operation name="registrarVenta"><soap:operation soapAction=""/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="buscarComprobante"><soap:operation soapAction=""/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="listarComprobantes"><soap:operation soapAction=""/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="anularComprobante"><soap:operation soapAction=""/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
    </binding>
    <service name="FacturacionNovaMarketImplementService">
        <port name="FacturacionNovaMarketImplementPort" binding="tns:FacturacionNovaMarketImplementPortBinding">
            <soap:address location="http://localhost:8090/ws/NovaMarketFacturacion"/>
        </port>
    </service>
</definitions>
